# Copy this file to ".env" (same folder) and fill in your values.
# .env is in .gitignore, so your keys never go to GitHub.

# Azure OpenAI (Foundry home page: "API key" and "Azure OpenAI endpoint")
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/openai/v1/
AZURE_OPENAI_KEY=paste-your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Backup only: if Azure OpenAI doesn't work, leave the Azure lines empty and fill this in
# (get a free key at aistudio.google.com/apikey)
GEMINI_API_KEY=
